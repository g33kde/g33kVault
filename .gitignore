node_modules/
dist/
client/dist/
server/public/
server/media/
server/data/
server/import/
*.log
.env
.DS_Store

# host-side drop folder for docker compose (server/importFolder.ts) —
# keep the folder tracked, ignore whatever gets dropped into it
/import/*
!/import/.gitkeep

# tvOS app's Xcode project is generated by XcodeGen from project.yml
# (`cd tvos/g33kVaultTV && xcodegen generate`) — not checked in, same idea
# as not committing a compiled binary.
tvos/*/*.xcodeproj/

# Real Alloy config holds actual Grafana Cloud credentials (see
# alloy/config.alloy.example and GRAFANA.md) — never commit it.
/alloy/config.alloy
