# Copy this file to .env and set a real password to enable the /admin
# view (delete/hide individual photos). Leaving it unset disables admin
# actions entirely rather than defaulting open.
ADMIN_PASSWORD=

# A second, separate password gating /admin's Trash section specifically —
# deliberately independent of ADMIN_PASSWORD, so whoever holds the everyday
# admin password (e.g. a helper running the event) can delete/restore
# photos but can't see what's in Trash or permanently empty it. Leaving it
# unset disables the Trash section entirely, same as ADMIN_PASSWORD above.
TRASH_PASSWORD=
